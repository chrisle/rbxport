# Copy to .env.sentry after the `Sentry DSN` 1Password item exists in the
# rbxport vault.  This file is intentionally ignored; build through 1Password
# so the DSN never lands in a shell history, committed file, or CI log.
VITE_SENTRY_DSN=op://rbxport.com/Sentry DSN/credential
SENTRY_DSN=op://rbxport.com/Sentry DSN/credential
# The item's ID avoids characters in its descriptive title that `op run`
# cannot parse in an op:// reference.
SENTRY_AUTH_TOKEN=op://rbxport.com/xtym7tqa27gku354rckozwkvk4/credential
